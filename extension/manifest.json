{
  "name": "ADHDNotes Extension",
  "version": "1.0.0",
  "description": "Sync text selections as text files.",
  "manifest_version": 3,
  "author": "Kavish",
  "action": {
    "default_popup": "index.html",
    "default_title": "ADHDNotes Extension"
  },
  "permissions": ["storage", "tabs", "scripting", "contextMenus"],
  "icons": {
    "32": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["script.js"]
    }
  ]
}
